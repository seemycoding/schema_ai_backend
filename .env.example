PORT=8000
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=schemaai
DB_USER=schemaai_user
DB_PASSWORD=replace_me

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TTL_MINUTES=30

FRONTEND_URL=https://schemaai.nodeinit.dev
FRONTEND_AUTH_CALLBACK_URL=https://schemaai.nodeinit.dev/auth/callback
FRONTEND_RESET_PASSWORD_URL=https://schemaai.nodeinit.dev/reset-password
CORS_ORIGINS=https://schemaai.nodeinit.dev

COLLAB_SERVER_ENABLED=false
COLLAB_SERVER_HOST=127.0.0.1
COLLAB_SERVER_PORT=1234

GEMINI_API_KEY=replace_me

GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me
GITHUB_REDIRECT_URI=https://schemaai.nodeinit.dev/api/auth/github/callback

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=https://schemaai.nodeinit.dev/api/auth/google/callback

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_SECURE=false
SMTP_FROM_EMAIL=noreply@schemaai.nodeinit.dev

